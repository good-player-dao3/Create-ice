{
	"schemaVersion": 1,
	"id": "create-ice",
	"version": "${version}",
	"name": "Create Ice",
	"description": "Create Fly的附属mod,增加了一些与冰相关的东西\nAn addon mod for Create Fly, adding some ice‑related items and recipes",
	"authors": [
		"good-player-dao3"
	],
	"contact": {
		"homepage": "https://www.bilibili.com/video/BV1GJ411x7h7/",
		"issues": "https://github.com/good-player-dao3/Create-ice/issues",
		"sources": "https://github.com/good-player-dao3/Create-ice/tree/master"
	},
	"license": "CC0-1.0",
	"icon": "assets/create-ice/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"create_ice.CreateIce"
		],
		"client": [
			"create_ice.client.CreateIceClient"
		],
		"fabric-datagen": [
			"create_ice.client.CreateIceDataGenerator"
		]
	},
	"mixins": [
		"create-ice.mixins.json",
		{
			"config": "create-ice.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.1.2",
		"create": "*",
		"java": ">=25",
		"fabric-api": "*"
	}
}